# WeSense Platform Configuration
# Copy this file to .env and customize as needed.
#
# Before starting, you MUST change the passwords marked CHANGEME below.
# The config-check service will refuse to start if default passwords are detected.
#
# The defaults use Docker service names (emqx, clickhouse) which work
# automatically inside the Docker network. Don't change these to IP
# addresses unless you know what you're doing.

# ===========================================
# Your Role
# ===========================================
# Choose how you contribute to the WeSense network.
#
# Main profiles:
#
#   +--------------+------------------------------------------+-------------------------------------------+
#   | Profile      | Description                              | Components included                       |
#   +--------------+------------------------------------------+-------------------------------------------+
#   | guardian      | Full environmental monitoring station — | MQTT Broker, Database, Meshtastic         |
#   |              | your own map, database, and permanent    | Ingester, WeSense Ingester, Home          |
#   |              | archive for your region                  | Assistant Ingester, Storage Broker,        |
#   |              |                                          | Archive Replicator, Map, Live Transport,  |
#   |              |                                          | Zenoh, OrbitDB, Classifier                |
#   +--------------+------------------------------------------+-------------------------------------------+
#   | contributor  | Send sensor data to the network —        | Meshtastic Ingester, WeSense Ingester,    |
#   |              | no local database or map                 | Home Assistant Ingester, Storage Broker,   |
#   |              |                                          | Archive Replicator                        |
#   +--------------+------------------------------------------+-------------------------------------------+
#   | hub          | Public MQTT endpoint for the network     | MQTT Broker, OrbitDB                      |
#   +--------------+------------------------------------------+-------------------------------------------+
#   | bootstrap    | Lightweight P2P discovery node (VPS)     | OrbitDB                                   |
#   +--------------+------------------------------------------+-------------------------------------------+
#
# Combine profiles for more roles:
#   guardian,hub — Full backbone (station + archive + public MQTT)
#
# Add-on profiles (extend a main profile):
#   tls          — Automatic Let's Encrypt certificates for MQTT
#   downlink     — Global Meshtastic ingest (high traffic, hub operators only)
#   govaq-nz     — NZ government air quality reference stations
#
# Deprecated (still works, will be removed in a future release):
#   station      — Use 'guardian' instead
#
COMPOSE_PROFILES=guardian

# ===========================================
# Guardian Scope
# ===========================================
# Which region's environmental archives to store permanently.
# Your guardian level is determined by your scope:
#
#   Bronze:   single area    (e.g. GUARDIAN_SCOPE=nz/wgn)
#   Silver:   full country   (e.g. GUARDIAN_SCOPE=nz/*)
#   Gold:     multi-country  (e.g. GUARDIAN_SCOPE=nz/*,au/*)
#   Platinum: everything     (GUARDIAN_SCOPE=*/*)
#
# Region codes use ISO 3166: country/subdivision
# Lookup: https://github.com/wesense-earth/wesense/wiki/Region-Codes
#
# Examples:
#   GUARDIAN_SCOPE=nz/wgn           (only Wellington, NZ)
#   GUARDIAN_SCOPE=nz/*             (all of New Zealand)
#   GUARDIAN_SCOPE=nz/*,au/*        (New Zealand and Australia)
#   GUARDIAN_SCOPE=*/*              (everything worldwide)
GUARDIAN_SCOPE=*/*

# ===========================================
# Component Overrides
# ===========================================
# Your chosen profile includes default components (listed in the table above).
# Disable any you don't need by setting to 0.
#
# For example, if you don't run Home Assistant, leave INGESTER_HOMEASSISTANT=0.
# Set to 1 to enable, 0 to disable.
INGESTER_MESHTASTIC=1
INGESTER_WESENSE=1
INGESTER_HOMEASSISTANT=0
# Add to COMPOSE_PROFILES to enable (e.g. COMPOSE_PROFILES=station,govaq-nz).

# ===========================================
# Data Directory
# ===========================================
# All persistent data is stored under this directory, organized by service:
#   data/clickhouse/data, data/clickhouse/logs
#   data/emqx/data, data/emqx/log
#   data/ingester-meshtastic/cache, data/ingester-meshtastic/logs
#   data/ingester-meshtastic-downlink/cache, data/ingester-meshtastic-downlink/logs
#   data/ingester-wesense/cache, data/ingester-wesense/logs
#   data/ingester-homeassistant/logs
#   data/storage-broker/keys, data/storage-broker/archives
#   data/archive-replicator
#   data/deployment-classifier/reports, data/deployment-classifier/logs
#   data/respiro
#
# Default is './data' (relative to this directory).
# For production, use an absolute path (e.g., /mnt/pool/wesense/data)
DATA_DIR=./data

# ===========================================
# Timezone
# ===========================================
TZ=Pacific/Auckland

# ===========================================
# Container User ID
# ===========================================
# UID:GID that services run as inside containers.
# Default 1000:1000 matches the emqx image default.
# TrueNAS: set to 568:568 (apps:apps)
PUID=1000
PGID=1000

# ===========================================
# ClickHouse
# ===========================================
# The database for storing sensor readings.
# Both passwords are required for guardian profiles.
# Change them from CHANGEME to real passwords before starting.
#
# CLICKHOUSE_ADMIN_PASSWORD: admin ('default') user — used internally by
#   the container for schema init. Not exposed to ingesters.
# CLICKHOUSE_USER / CLICKHOUSE_PASSWORD: restricted app user — created
#   automatically on first start by 00-create-app-user.sh. Used by ingesters
#   and Respiro. Has SELECT/INSERT only on wesense and wesense_respiro databases.
CLICKHOUSE_DB=wesense
CLICKHOUSE_ADMIN_PASSWORD=CHANGEME
CLICKHOUSE_USER=wesense
CLICKHOUSE_PASSWORD=CHANGEME

# ClickHouse data directory (sensor readings — can grow large)
# Defaults to DATA_DIR/clickhouse. Override to store on a separate drive.
# Example: CLICKHOUSE_DATA_DIR=/mnt/hdd_pool/clickhouse
#CLICKHOUSE_DATA_DIR=

# Leave as 'clickhouse' for guardian profile (Docker service name)
# Only change if connecting to an external ClickHouse server
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# Storage broker batching settings (for ClickHouse writes)
CLICKHOUSE_BATCH_SIZE=100
CLICKHOUSE_FLUSH_INTERVAL=10

# ===========================================
# MQTT Broker (EMQX)
# ===========================================
# Leave as 'emqx' for guardian profile (Docker service name)
# For contributor profile: set to your remote hub (e.g., mqtt.wesense.earth)
MQTT_HOST=emqx
MQTT_PORT=1883

# MQTT authentication (opt-in)
# Set both MQTT_USER and MQTT_PASSWORD to enable EMQX password authentication.
# Leave both empty for anonymous access (default — fine for local networks).
# The init-auth.sh entrypoint script configures EMQX automatically.
MQTT_USER=
MQTT_PASSWORD=

# Meshtastic forwarding — forwards msh/# traffic to external Meshtastic maps.
# Only enable on ONE host to avoid duplicate messages. Default: all off.
# Server/credentials are in emqx.conf. To change them, use the EMQX dashboard
# (Data Integration → Connectors).
MESHTASTIC_FORWARDING_ENABLED=false
MESHTASTIC_FWD_1_ENABLED=false
# Slot 1: Liam Cottle map (mqtt.meshtastic.liamcottle.net)
MESHTASTIC_FWD_2_ENABLED=false
# Slot 2: Default Meshtastic (mqtt.meshtastic.org)

# EMQX dashboard password (required for hub/guardian profiles)
# The dashboard is at http://<host>:18083 — login as 'admin' with this password.
# Change from CHANGEME to a real password before starting.
EMQX_DASHBOARD_PASSWORD=CHANGEME

# ===========================================
# Host Port Mapping
# ===========================================
# Ports exposed from containers to your host machine.
# Services always communicate internally via Docker network.

# MQTT — for sensors and devices to connect from outside Docker
# If you already have an MQTT broker (e.g., Mosquitto for Home Assistant),
# change this to avoid a port conflict (e.g., 1884).
PORT_MQTT=1883

# Respiro map — typically put behind a reverse proxy for HTTPS
# Change if port 3001 is already in use (e.g., Grafana, Home Assistant add-ons).
PORT_RESPIRO=3001

# Docker container resource stats on the Respiro Stats dashboard.
# Uncomment both lines to enable.
#DOCKER_SOCK=/var/run/docker.sock
#DOCKER_STATS_ENABLED=true
# Only show containers matching this name prefix (default: wesense)
#DOCKER_STATS_CONTAINER_PREFIX=wesense

# ===========================================
# TLS Configuration (optional)
# ===========================================
#
# --- MQTT TLS (sensors → EMQX) ---
# Encrypts sensor traffic. Pick ONE option:
#
# OPTION A: Let's Encrypt (internet-facing, fully automatic)
#   1. Add "tls" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=station,tls)
#   2. Set TLS_DOMAIN and CLOUDFLARE_API_TOKEN below
#   3. Set TLS_MQTT_ENABLED=true
#   4. Restart — certbot container handles everything
#   ESP32 sensors: set MQTT_USE_TLS=true and port 8883 in credentials.h
#
# OPTION B: Self-signed CA (LAN-only, no domain needed)
#   1. Run: ./scripts/generate-certs.sh
#   2. Set TLS_MQTT_ENABLED=true
#   3. Restart
#   ESP32 sensors: replace ca_cert.h with your CA cert, reflash once
#
TLS_MQTT_ENABLED=false
TLS_WS_ENABLED=false

# Let's Encrypt settings (only needed for Option A):
# Domain for the MQTT certificate
#TLS_DOMAIN=mqtt.wesense.earth
# Cloudflare API token with Zone:DNS:Edit permission for your domain.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Use the "Edit zone DNS" template, scoped to your domain.
#CLOUDFLARE_API_TOKEN=
# Email for Let's Encrypt expiry notifications (optional but recommended)
#CERTBOT_EMAIL=
# Set to true to use Let's Encrypt staging (for testing, certs won't be trusted)
#CERTBOT_STAGING=false
#
# Auto-renewal is handled by the certbot container (checks every 12 hours).
# No cron jobs or manual renewal needed.

# --- Internal TLS (service-to-service) ---
# Encrypts all traffic between Docker services (ClickHouse, storage broker,
# archive replicator, OrbitDB, etc). Requires generate-certs.sh first.
# Not needed for most LAN deployments — traffic never leaves the host.
TLS_ENABLED=false

# Port mappings (change if these conflict with other services)
PORT_MQTT_TLS=8883
PORT_MQTT_WSS=8084

# ===========================================
# WeSense Ingester
# ===========================================
# TTN webhook (optional HTTP receiver for The Things Network)
# Requires a Cloudflare tunnel or exposed port — see docker-compose.override.yml.sample
TTN_WEBHOOK_ENABLED=false
#CLOUDFLARED_TUNNEL_TOKEN=

# ===========================================
# Home Assistant Ingester (optional)
# ===========================================
# Only needed if you want to pull data from Home Assistant.
# Create config/config.yaml from config/config.yaml.sample to enable.
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=
HA_NODE_NAME=

# ===========================================
# Contributor Profile — Remote Hub Settings
# ===========================================
# If running as 'contributor' (ingesters only, no local EMQX/ClickHouse),
# uncomment and set these to point to your remote hub:
#MQTT_HOST=mqtt.wesense.earth
#MQTT_PORT=8883
#MQTT_USE_TLS=true
#WESENSE_OUTPUT_BROKER=mqtt.wesense.earth
#WESENSE_OUTPUT_PORT=8883

# ===========================================
# Zenoh P2P Network (optional)
# ===========================================
# The live transport is the single integration point between MQTT and Zenoh.
# Outbound: subscribes to MQTT decoded/# and publishes to Zenoh (all ingesters
#           automatically get P2P distribution without any Zenoh config).
# Inbound:  subscribes to Zenoh, verifies signatures, writes to ClickHouse.
ZENOH_ENABLED=true
ZENOH_MODE=client
# For station: local zenohd. For contributor: community router(s).
ZENOH_ROUTERS=tcp/zenohd:7447
#ZENOH_ROUTERS=tcp/router1.wesense.earth:7447,tcp/router2.wesense.earth:7447
ZENOH_KEY_PREFIX=wesense/v2/live
PORT_ZENOH=7447

# Live transport MQTT outbound — subscribes to local MQTT and forwards to Zenoh.
# Enabled by default on guardian profile.
# Uses MQTT_USER/MQTT_PASSWORD from above for authentication.
MQTT_BRIDGE_ENABLED=true
# Topic to subscribe to (default picks up all decoded readings from all ingesters)
#MQTT_SUBSCRIBE_TOPIC=wesense/decoded/#

# LAN IP for Zenoh peer discovery between stations on the same network.
# When ANNOUNCE_ADDRESS is a public/WAN IP, set this to the host's LAN IP
# so local stations connect directly instead of routing through the internet.
# Not needed if ANNOUNCE_ADDRESS is already a LAN IP or is unset.
#ZENOH_LAN_ADDRESS=192.168.43.11

# WeSense Proxy — LAN IP of the station handling WAN P2P connectivity.
# When set, this station routes all P2P traffic (Zenoh + Iroh) through the
# proxy station. ANNOUNCE_ADDRESS is ignored when proxied.
#
# Example: two stations on the same LAN:
#   .13 (proxy): ANNOUNCE_ADDRESS=203.0.113.1  (public IP, handles WAN P2P)
#   .11 (proxied): WESENSE_PROXY=192.168.43.13  (routes through .13)
#WESENSE_PROXY=
# Override proxy ports if the proxy station uses non-standard ports.
# Defaults match PORT_ZENOH (7447) and PORT_IROH_QUIC (4401).
#WESENSE_PROXY_ZENOH_PORT=7447
#WESENSE_PROXY_IROH_PORT=4401

# Zenoh API — distributed query frontend (station + observer profiles)
# Query timeout for collecting responses from all queryables
ZENOH_QUERY_TIMEOUT=5.0
# Zenoh API URL for Respiro P2P proxy (auto-configured for Docker)
#ZENOH_API_URL=http://zenoh-api:5100

# ===========================================
# OrbitDB Registry
# ===========================================
# Automatic node registration and trust list synchronisation.
# Peer discovery: LAN via mDNS, WAN via bootstrap peers.
ORBITDB_ENABLED=true
ORBITDB_URL=http://wesense-orbitdb:5200
ORBITDB_SYNC_INTERVAL=3600

# Bootstrap peers — other WeSense OrbitDB instances to connect to directly.
# Comma-separated. Stations will dial these addresses on startup and
# periodically reconnect. Supports multiple formats:
#
#   Just IP:        192.168.1.50           (uses PORT_ORBITDB_P2P, default 4002)
#   IP:port:        192.168.1.50:4002
#   Hostname:       bootstrap.wesense.earth (uses PORT_ORBITDB_P2P, default 4002)
#   Hostname:port:  bootstrap.wesense.earth:4002
#   Full multiaddr: /ip4/203.0.113.1/tcp/4001/p2p/12D3KooW...
#
# Default: bootstrap.wesense.earth (the WeSense project's public bootstrap node).
# The network works without it — LAN peers discover each other via mDNS — but
# connecting to a bootstrap node speeds up WAN peer discovery and enables
# replication across sites. Anyone can run their own bootstrap node using the
# bootstrap profile.
#
# Add your own LAN station IPs for faster local discovery if mDNS is unreliable:
#   ORBITDB_BOOTSTRAP_PEERS=bootstrap.wesense.earth,192.168.43.11,192.168.43.13
#
# Safe to list ALL station IPs (including this one) — self-dial is ignored.
ORBITDB_BOOTSTRAP_PEERS=bootstrap.wesense.earth

# Public IP or hostname for this node. Used by:
#   1. OrbitDB/Helia — libp2p announce multiaddr (P2P database replication across WAN)
#   2. Live transport — registered as zenoh_endpoint in OrbitDB for remote peer discovery
#   3. Archive replicator — QUIC announce address for archive replication
# Accepts an IPv4 address (e.g., 203.0.113.1) or FQDN (e.g., bootstrap.wesense.earth).
# Bootstrap profile: required — must be the VPS's public IP or hostname so home stations can connect.
# Ports that must be forwarded/open: 4002 TCP (OrbitDB libp2p), 7447 TCP (Zenoh).
# Not needed if WESENSE_PROXY is set — the proxy handles P2P distribution
# and this node doesn't need to be directly discoverable.
#ANNOUNCE_ADDRESS=

# OrbitDB libp2p port (network_mode: host, so this binds directly).
PORT_ORBITDB_P2P=4002

# ===========================================
# Bootstrap Profile — Lightweight Cloud Discovery Node
# ===========================================
# For running a public OrbitDB peer on a VPS (e.g., bootstrap.wesense.earth).
# Only runs the OrbitDB container — no EMQX, ClickHouse, ingesters, or Respiro.
# No passwords required (config-check does not run for bootstrap profile).
#
# Minimum VPS: 1 vCPU, 512MB RAM, 10GB disk (OrbitDB uses ~80MB RAM).
#
# Home stations connect to this bootstrap node by adding its address to
# ORBITDB_BOOTSTRAP_PEERS in their own .env:
#   ORBITDB_BOOTSTRAP_PEERS=<bootstrap-vps-ip>

# ===========================================
# Archive Settings (guardian profile)
# ===========================================
# Hours between archive cycles (default 4)
ARCHIVE_INTERVAL_HOURS=4
# Earliest date to consider for archiving (empty = use earliest ClickHouse data)
# Set this to avoid archiving years of old data on first run
#ARCHIVE_START_DATE=2025-01-01

# ===========================================
# Iroh P2P Archive Replication
# ===========================================
# The archive replicator distributes BLAKE3-addressed archives between WeSense
# stations over direct QUIC connections. Archives are announced via gossip and
# downloaded by peers whose store scope matches.

# QUIC port for iroh P2P connections (UDP). Must be port-forwarded for WAN replication.
PORT_IROH_QUIC=4401

# Bootstrap peers — iroh node IDs or addresses to connect to on startup.
# Comma-separated. These are iroh-specific peers (separate from OrbitDB bootstrap).
#IROH_BOOTSTRAP_PEERS=

# DERP relay URLs for NAT traversal fallback. Comma-separated.
# When hole-punching fails (e.g. carrier-grade NAT), traffic routes via relays.
# Hub operators can run `iroh-relay --hostname derp.wesense.earth` on a VPS.
#IROH_RELAY_URLS=https://derp.wesense.earth

# Archive Replicator URL for Respiro stats proxy (auto-configured in docker-compose).
#ARCHIVE_REPLICATOR_URL=http://archive-replicator:4400

# ===========================================
# Container Resource Limits
# ===========================================
# Memory and CPU caps per service. Docker will OOM-kill a container that
# exceeds its limit rather than letting it consume all host RAM.
# Increase these if you see containers restarting with OOM errors in logs.
#
# OrbitDB (libp2p + Helia + OrbitDB replication)
#ORBITDB_MEM_LIMIT=2G
#ORBITDB_CPU_LIMIT=2
#
# Archive Replicator (Rust, QUIC blob storage + gossip)
#ARCHIVE_REPLICATOR_MEM_LIMIT=2G
#ARCHIVE_REPLICATOR_CPU_LIMIT=2
#
# Storage Broker (Python, ingestion + archive builder)
#STORAGE_BROKER_MEM_LIMIT=1G
#
# WeSense Ingester (Python, MQTT + optional TTN webhook)
#INGESTER_WESENSE_MEM_LIMIT=1G

# ===========================================
# Logging
# ===========================================
DEBUG=false
LOG_LEVEL=INFO
# Archive replicator log level (Rust). Set to debug for troubleshooting replication.
#RUST_LOG=wesense_archive_replicator=debug

# ===========================================
# Map Settings (optional)
# ===========================================
# Override map centre (auto-detects from sensor data by default)
#MAP_CENTER_LAT=-36.848
#MAP_CENTER_LNG=174.763
#MAP_ZOOM_LEVEL=10

# ===========================================
# Container Images
# ===========================================
# Controls which version of all WeSense container images to pull.
# This single variable sets the tag for every service at once.
#
# Available tags:
#   latest  — Stable release (built from main branch)
#   dev     — Development builds (built from dev branch, may be unstable)
#   v1.2.3  — Pinned release version
#
# To test new features before they're merged to main:
#   IMAGE_TAG=dev
#
# To go back to stable:
#   IMAGE_TAG=latest
IMAGE_TAG=latest

# Override individual images if needed (takes precedence over IMAGE_TAG).
# Only uncomment these if you need a specific service on a different tag
# or want to point at a local build.
#INGESTER_MESHTASTIC_IMAGE=ghcr.io/wesense-earth/wesense-ingester-meshtastic:latest
#INGESTER_WESENSE_IMAGE=ghcr.io/wesense-earth/wesense-ingester-wesense:latest
#INGESTER_HA_IMAGE=ghcr.io/wesense-earth/wesense-ingester-homeassistant:latest
#INGESTER_GOVAQ_NZ_IMAGE=ghcr.io/wesense-earth/wesense-ingester-govaq-nz:latest
#RESPIRO_IMAGE=ghcr.io/wesense-earth/wesense-respiro:latest
#CLASSIFIER_IMAGE=ghcr.io/wesense-earth/wesense-deployment-classifier:latest
#LIVE_TRANSPORT_IMAGE=ghcr.io/wesense-earth/wesense-live-transport:latest
#ZENOH_API_IMAGE=ghcr.io/wesense-earth/wesense-zenoh-api:latest
#ORBITDB_IMAGE=ghcr.io/wesense-earth/wesense-orbitdb:latest
#STORAGE_BROKER_IMAGE=ghcr.io/wesense-earth/wesense-storage-broker:latest
#ARCHIVE_REPLICATOR_IMAGE=ghcr.io/wesense-earth/wesense-archive-replicator:latest
